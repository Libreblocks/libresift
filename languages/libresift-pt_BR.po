msgstr "Um link que remove todos os filtros ativos."

msgid "A list I type"
msgstr "Uma lista que eu digito"

msgid "A taxonomy (categories, cities…)"
msgstr "Uma taxonomia (categorias, cidades…)"

msgid "Accent color"
msgstr "Cor de destaque"

msgid "Actions"
msgstr "Ações"

msgid "Active"
msgstr "Ativo"

msgid "Add at least one sorting option."
msgstr "Adicione pelo menos uma opção de ordenação."

msgid "Add option"
msgstr "Adicionar opção"

msgid "Add sorting option"
msgstr "Adicionar opção de ordenação"

msgid "Advanced settings"
msgstr "Configurações avançadas"

msgid "After the number"
msgstr "Depois do número"

