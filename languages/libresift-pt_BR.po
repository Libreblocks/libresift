msgstr "Automático (recomendado)"

msgid "Automatic = every term of the taxonomy."
msgstr "Automático = todos os termos da taxonomia."

msgid "Automatic = the options of the field, or the values already saved."
msgstr "Automático = as opções do campo ou os valores já salvos."

msgid "Before the number"
msgstr "Antes do número"

msgid "Button text"
msgstr "Texto do botão"

msgid "Checkboxes (choose many)"
msgstr "Caixas de seleção (escolher vários)"

msgid "Choose a filter (LibreSift → Filters)."
msgstr "Escolha um filtro (LibreSift → Filtros)."

msgid "Choose a filter in the sidebar."
msgstr "Escolha um filtro na barra lateral."

msgid "Choose the custom field."
msgstr "Escolha o campo personalizado."

msgid "Choose the taxonomy."
msgstr "Escolha a taxonomia."

msgid "City"
msgstr "Cidade"

msgid "Clear filters"
msgstr "Limpar filtros"

msgid "Color"
msgstr "Cor"

msgid "Compare values as"
msgstr "Comparar valores como"

msgid "Could not update the results. Reload the page to try again."
msgstr "Não foi possível atualizar os resultados. Recarregue a página para tentar de novo."

msgid "Create filter"
msgstr "Criar filtro"

msgid "Create filters in LibreSift → Filters."
msgstr "Crie filtros em LibreSift → Filtros."

msgid "Create your first filter"
msgstr "Crie seu primeiro filtro"

msgid "Create your first filter in LibreSift → Filters, then choose it here."
msgstr "Crie seu primeiro filtro em LibreSift → Filtros e depois escolha aqui."

msgid "Custom field"
msgstr "Campo personalizado"

msgid "Custom field (number)"
msgstr "Campo personalizado (número)"

