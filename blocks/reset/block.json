{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "libresift/reset",
	"title": "Clear filters",
	"category": "libreforge",
	"icon": "dismiss",
	"description": "A link that removes every active filter.",
	"keywords": [
		"reset",
		"clear",
		"filter"
	],
	"textdomain": "libresift",
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		},
		"color": {
			"text": true,
			"background": true
		}
	},
	"editorScript": "libresift-blocks",
	"style": "libresift"
}
